{
    "$schema": "https://biomejs.dev/schemas/2.5.9/schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "ignoreUnknown": true,
        "includes": ["**", "!node_modules", "!.next", "!dist", "!build", "!packages/db/database.types.ts"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 120,
        "formatWithErrors": true
    },
    "css": {
        "parser": {
            "tailwindDirectives": true
        }
    },
    "linter": {
        "rules": {
            "a11y": {
                "noSvgWithoutTitle": "off"
            },
            "complexity": {
                "noImportantStyles": "off"
            },
            "correctness": {
                "useExhaustiveDependencies": "off"
            },
            "suspicious": {
                "noUnknownAtRules": {
                    "level": "error",
                    "options": {
                        "ignore": ["tailwind"]
                    }
                },
                "noArrayIndexKey": "off",
                "noConsole": {
                    "level": "error",
                    "options": {
                        "allow": ["info", "error"]
                    }
                }
            }
        },
        "domains": {
            "next": "recommended",
            "react": "recommended"
        }
    },
    "assist": {
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    }
}
